# GitHub Personal Access Token
# Used for GitHub API operations: querying repository metadata,
# checking mirror existence, and creating mirror repos in your org.
#
# Required scopes:
#   public_repo  - for public repos (create public mirrors, read metadata)
#   repo         - for private repos (all of the above + private repo access)
GITHUB_TOKEN=

# Custom SSH key for private repo operations (optional)
# If not set, the system looks for default keys in ~/.ssh/
# (id_rsa, id_ecdsa, id_ed25519, etc.)
#
# Set this only if your GitHub SSH key is at a non-standard path.
# GITHUB_USER_SSH_KEY=/home/user/.ssh/id_ed25519_github

# --- Bedrock LLM ---

# Model identifier for Bedrock. Use an ARN for inference profiles, or a standard model ID.
# Default (if unset): bedrock/anthropic.claude-opus-4-7
# SWESMITH_BEDROCK_MODEL=bedrock/converse/arn:aws:bedrock:<region>:<account-id>:application-inference-profile/<profile-id>

# JSON mapping of inference-profile ARN -> base model for pricing.
# Used by swesmith.llm_pricing to resolve ARNs to known models for cost calculation.
# Example: {"bedrock/converse/arn:aws:bedrock:ap-south-1:123456789:application-inference-profile/abc123": "bedrock/anthropic.claude-opus-4-7"}
SWESMITH_ARN_MODEL_MAP=

# Global override for cost calculation base model.
# When set, ALL cost lookups use this model regardless of the ARN map above.
# Default (if unset): bedrock/anthropic.claude-opus-4-7
# SWESMITH_COST_BASE_MODEL=bedrock/anthropic.claude-opus-4-7

# Set to "1", "true", or "yes" to skip litellm.register_model() registration.
# Useful for debugging or when litellm pricing is handled externally.
# SWESMITH_DISABLE_COST_REGISTRATION=0
